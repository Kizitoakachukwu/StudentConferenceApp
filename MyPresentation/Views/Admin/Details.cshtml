@model StudentConferenceApp.BLL.DTOs.ParticipantDto

@{
    ViewData["Title"] = "Participant Details";
}

<h2 class="mb-4">Participant Details</h2>

<div class="card p-4 shadow-sm">
    <p><strong>Name:</strong> @Model.FullName</p>
    <p><strong>Institution:</strong> @Model.Institution</p>
    <p><strong>Paper Title:</strong> @Model.PaperTitle</p>
    <p><strong>Email:</strong> @Model.Email</p>
    <p><strong>Phone:</strong> @Model.Phone</p>
    <p><strong>Section:</strong> @Model.SectionName</p>
    <p><strong>Participation Type:</strong> @Model.ParticipationType</p>
    <p><strong>Status:</strong> @Model.Status</p>
</div>

<a href="/Admin" class="btn btn-primary mt-3">Back to Dashboard</a>
