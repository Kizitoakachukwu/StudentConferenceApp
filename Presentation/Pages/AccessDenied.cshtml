@page
@model Microsoft.AspNetCore.Mvc.RazorPages.PageModel
@{
    ViewData["Title"] = "Access denied";
}

<div class="container py-5">
    <div class="sc-panel p-5 text-center" style="max-width: 480px; margin: 0 auto;">
        <div class="text-danger display-4 mb-3"><i class="bi bi-shield-x"></i></div>
        <h1 class="h4 fw-bold mb-2">Access denied</h1>
        <p class="text-muted mb-4">You do not have permission to view this page. If you need access, contact an administrator.</p>
        <a asp-page="/Index" class="btn btn-primary sc-btn-primary">Return home</a>
    </div>
</div>
