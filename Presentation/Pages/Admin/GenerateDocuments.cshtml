@page
@model Presentation.Pages.Admin.GenerateDocumentsModel
@{
    ViewData["Title"] = "Documents";
}

<div class="container py-4 py-md-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold text-white mb-1">Document generation</h1>
            <p class="text-secondary mb-0">Certificates, invitations, and conference final report</p>
        </div>
        <a asp-page="/Admin/Dashboard" class="btn btn-outline-light btn-sm border-secondary">← Admin home</a>
    </div>

    <div class="sc-panel p-4 p-md-5 mb-4">
        <h2 class="h5 fw-semibold mb-3">Per participant</h2>
        <form method="post" class="row g-3 align-items-end">
            <motion class="col-md-8">
                <label asp-for="SelectedParticipantId" class="form-label">Participant</label>
                <select asp-for="SelectedParticipantId" class="form-select">
                    <option value="">— Select —</option>
                    @foreach (var p in Model.Participants)
                    {
                        <option value="@p.Id">@p.FullName (@p.Email)</option>
                    }
                </select>
            </motion>
            <motion class="col-md-4 d-flex flex-wrap gap-2">
                <button asp-page-handler="GenerateCertificate" type="submit" class="btn btn-primary sc-btn-primary flex-grow-1">Certificate</button>
                <button asp-page-handler="GenerateInvitation" type="submit" class="btn btn-outline-secondary flex-grow-1">Invitation</button>
            </motion>
        </form>
    </motion>

    <motion class="sc-panel p-4 p-md-5">
        <h2 class="h5 fw-semibold mb-2">Final report (all participants)</h2>
        <p class="text-muted small mb-3">Official layout: section headers, paper titles, speakers, supervisors. Export as <strong>Word (.docx)</strong> or <strong>PDF</strong>.</p>
        <motion class="d-flex flex-wrap gap-2">
            <form method="post" asp-page-handler="GenerateFinalReport">
                <button type="submit" class="btn btn-warning text-dark fw-semibold">
                    <i class="bi bi-file-earmark-word me-1"></i>Generate Word (.docx)
                </button>
            </form>
            <form method="post" asp-page-handler="GenerateFinalReportPdf">
                <button type="submit" class="btn btn-danger fw-semibold">
                    <i class="bi bi-file-earmark-pdf me-1"></i>Generate PDF
                </button>
            </form>
        </motion>
        @if (!string.IsNullOrEmpty(Model.FinalReportPath))
        {
            <motion class="alert alert-success mt-4 mb-0" role="alert">
                Word report ready. <a href="@Model.FinalReportPath" class="alert-link fw-semibold" download>Download .docx</a>
            </motion>
        }
        @if (!string.IsNullOrEmpty(Model.FinalReportPdfPath))
        {
            <motion class="alert alert-success mt-3 mb-0" role="alert">
                PDF report ready. <a href="@Model.FinalReportPdfPath" class="alert-link fw-semibold" download>Download .pdf</a>
            </motion>
        }
    </motion>
</motion>
