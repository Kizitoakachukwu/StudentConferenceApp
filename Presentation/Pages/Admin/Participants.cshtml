@page
@model Presentation.Pages.Models.ParticipantsModel
@{
    ViewData["Title"] = "Participants";
}

<div class="container py-4 py-md-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold text-white mb-1">Participants</h1>
            <p class="text-secondary mb-0">Review applications and update status</p>
        </div>
        <a asp-page="/Admin/Dashboard" class="btn btn-outline-light btn-sm border-secondary">← Admin home</a>
    </div>

    <div class="sc-panel p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Name</th>
                        <th>Email</th>
                        <th>Section</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Participants.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-5">No participants registered yet.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var p in Model.Participants)
                        {
                            <tr>
                                <td class="ps-4 fw-medium">@p.FullName</td>
                                <td class="small">@p.Email</td>
                                <td>@p.SectionName</td>
                                <td>
                                    <span class="badge rounded-pill @(p.Status == "Approved" ? "bg-success" : p.Status == "Rejected" ? "bg-danger" : "bg-warning text-dark")">
                                        @p.Status
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <form method="post" asp-page-handler="Approve" asp-route-id="@p.Id" class="d-inline">
                                        <button type="submit" class="btn btn-success btn-sm">Approve</button>
                                    </form>
                                    <form method="post" asp-page-handler="Reject" asp-route-id="@p.Id" class="d-inline ms-1">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Reject</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
