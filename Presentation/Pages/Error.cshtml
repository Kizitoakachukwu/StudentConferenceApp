@page
@model Microsoft.AspNetCore.Mvc.RazorPages.PageModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5">
    <div class="sc-panel p-5 text-center" style="max-width: 520px; margin: 0 auto;">
        <div class="text-danger display-4 mb-3"><i class="bi bi-exclamation-octagon"></i></div>
        <h1 class="h4 fw-bold mb-2">Something went wrong</h1>
        <p class="text-muted mb-4">An unexpected error occurred while processing your request. Please try again later.</p>
        <a asp-page="/Index" class="btn btn-primary sc-btn-primary">Return home</a>
    </div>
</div>
