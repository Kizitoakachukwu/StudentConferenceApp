@page
@model ManagerDashboardModel
@{
    ViewData["Title"] = "Supervisor";
}

<div class="container py-4 py-md-5">
    @if (TempData["SuccessMessage"] is string okMsg)
    {
        <div class="alert alert-success shadow-sm" role="alert">@okMsg</div>
    }
    @if (TempData["ErrorMessage"] is string errMsg)
    {
        <div class="alert alert-danger shadow-sm" role="alert">@errMsg</div>
    }

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold text-white mb-1">Supervisor dashboard</h1>
            <p class="text-secondary mb-0">All conference participants — review and update application status</p>
        </div>
        @if (Model.Participants.Count > 0)
        {
            <span class="badge bg-secondary align-self-md-center">@Model.Participants.Count participant@(Model.Participants.Count == 1 ? "" : "s")</span>
        }
    </div>

    <div class="sc-panel p-3 p-md-4 mb-4" id="manager-commands">
        <h2 class="h6 text-secondary text-uppercase fw-semibold mb-3">Manager commands</h2>
        <p class="small text-muted mb-3 mb-md-0">Export the full participant list (Word, PDF, CSV, …) or change status in the table below.</p>
        <div class="d-flex flex-wrap gap-2">
            @if (Model.Participants.Count > 0)
            {
                <a class="btn btn-sm btn-primary sc-btn-primary" asp-page="/Manager/Dashboard" asp-page-handler="ExportWord" title="Microsoft Word .docx">
                    <i class="bi bi-file-earmark-word me-1"></i>Word (.docx)
                </a>
                <a class="btn btn-sm btn-danger" asp-page="/Manager/Dashboard" asp-page-handler="ExportPdf" title="PDF document">
                    <i class="bi bi-file-earmark-pdf me-1"></i>PDF
                </a>
                <a class="btn btn-sm btn-outline-light" asp-page="/Manager/Dashboard" asp-page-handler="ExportCsv" title="UTF-8 CSV for Excel">
                    <i class="bi bi-filetype-csv me-1"></i>Export CSV
                </a>
                <a class="btn btn-sm btn-outline-light" asp-page="/Manager/Dashboard" asp-page-handler="ExportRoster" title="Tab-separated lines">
                    <i class="bi bi-file-text me-1"></i>Export roster (.txt)
                </a>
                <a class="btn btn-sm btn-outline-light" asp-page="/Manager/Dashboard" asp-page-handler="ExportJson" title="JSON including supervisor fields">
                    <i class="bi bi-braces me-1"></i>Export JSON
                </a>
            }
            else
            {
                <button type="button" class="btn btn-sm btn-outline-secondary" disabled>Word (.docx)</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" disabled>PDF</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" disabled>Export CSV</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" disabled>Export roster (.txt)</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" disabled>Export JSON</button>
                <span class="small text-muted align-self-center">No participants registered yet.</span>
            }
        </div>
    </div>

    @if (Model.Participants.Count == 0)
    {
        <div class="sc-panel p-4">
            <p class="text-secondary mb-0">No participants have completed conference registration yet.</p>
        </div>
    }
    else
    {
        <div class="table-responsive sc-panel">
            <table class="table table-dark table-hover mb-0 align-middle">
                <thead>
                    <tr class="text-secondary small text-uppercase">
                        <th>Speaker</th>
                        <th>Email</th>
                        <th>Paper</th>
                        <th>Section</th>
                        <th>Supervisor</th>
                        <th class="text-end">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Participants)
                    {
                        <tr>
                            <td>@p.FullName</td>
                            <td>@p.Email</td>
                            <td>@p.PaperTitle</td>
                            <td>@p.SectionName</td>
                            <td class="text-muted small">@(string.IsNullOrWhiteSpace(p.ManagerFullName) ? "—" : p.ManagerFullName)</td>
                            <td class="text-end" style="min-width: 12rem;">
                                <form method="post" asp-page-handler="SetStatus" class="d-flex flex-column flex-xl-row gap-2 justify-content-xl-end align-items-stretch align-items-xl-center">
                                    <input type="hidden" name="participantId" value="@p.Id" />
                                    <select name="status" class="form-select form-select-sm bg-dark text-light border-secondary" aria-label="Application status for @p.FullName">
                                        @foreach (var s in new[] { "Pending", "Approved", "Rejected" })
                                        {
                                            if (string.Equals(p.Status, s, StringComparison.OrdinalIgnoreCase))
                                            {
                                                <option value="@s" selected>@s</option>
                                            }
                                            else
                                            {
                                                <option value="@s">@s</option>
                                            }
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-primary sc-btn-primary text-nowrap">Apply</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
