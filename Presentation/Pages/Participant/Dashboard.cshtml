@page
@model Presentation.Pages.Models.ParticipantDashboardModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container py-4 py-md-5">
    @if (TempData["SuccessMessage"] is string msg)
    {
        <div class="alert alert-success shadow-sm" role="alert">@msg</div>
    }

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold text-white mb-1">Participant dashboard</h1>
            <p class="text-secondary mb-0">Overview of your conference profile</p>
        </div>
        <a asp-page="/Participant/MyDocuments" class="btn btn-primary sc-btn-primary">
            <i class="bi bi-folder2-open me-1"></i>Documents
        </a>
    </div>

    <div class="sc-panel p-4 p-md-5">
        <div class="row g-4">
            <div class="col-lg-8">
                <h2 class="h5 fw-semibold mb-3">Profile</h2>
                <dl class="row mb-0 small">
                    <dt class="col-sm-4 text-muted">Speaker</dt>
                    <dd class="col-sm-8">@Model.Participant!.FullName</dd>
                    <dt class="col-sm-4 text-muted">Email</dt>
                    <dd class="col-sm-8">@Model.Participant.Email</dd>
                    <dt class="col-sm-4 text-muted">Institution</dt>
                    <dd class="col-sm-8">@Model.Participant.Institution</dd>
                    <dt class="col-sm-4 text-muted">Paper title</dt>
                    <dd class="col-sm-8">@Model.Participant.PaperTitle</dd>
                    <dt class="col-sm-4 text-muted">Section</dt>
                    <dd class="col-sm-8">@Model.Participant.SectionName</dd>
                    <dt class="col-sm-4 text-muted">Participation</dt>
                    <dd class="col-sm-8">@Model.Participant.ParticipationMethod</dd>
                </dl>
            </div>
            <div class="col-lg-4">
                <h2 class="h5 fw-semibold mb-3">Status</h2>
                <span class="badge rounded-pill fs-6 px-3 py-2 @(Model.Participant.Status == "Approved" ? "bg-success" : Model.Participant.Status == "Rejected" ? "bg-danger" : "bg-warning text-dark")">
                    @Model.Participant.Status
                </span>
            </div>
        </div>
    </div>
</div>
