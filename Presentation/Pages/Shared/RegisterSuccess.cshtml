@page
@model StudentConferenceApp.Web.Pages.RegisterSuccessModel
@{
    ViewData["Title"] = "Success";
}

<section class="py-5 min-vh-100 d-flex align-items-center sc-hero">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-5">
                <div class="sc-card text-center p-4 p-md-5">
                    <div class="text-success display-4 mb-3"><i class="bi bi-check-circle-fill"></i></div>
                    <h1 class="h3 fw-bold mb-2">Success</h1>
                    <p class="text-secondary mb-4">Thank you, <strong class="text-light">@Model.Name</strong>.</p>
                    <div class="alert alert-info border-0 small text-start mb-4" style="background: rgba(14, 165, 233, 0.12); color: var(--sc-text);">
                        Your request has been recorded. You can return to the home page or sign in when your account is ready.
                    </div>
                    <a asp-page="/Index" class="btn btn-light btn-lg px-4 fw-semibold">Home</a>
                </div>
            </div>
        </div>
    </div>
</section>
