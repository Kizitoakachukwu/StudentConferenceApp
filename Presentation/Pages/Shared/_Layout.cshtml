<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — StudentConferenceApp</title>
    <link rel="icon" type="image/png" href="~/images/logo.png" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body { font-family: "DM Sans", var(--sc-font, system-ui), sans-serif; }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark sc-navbar">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 py-0" asp-page="/Index">
                    <img src="~/images/logo.png" alt="StudentConferenceApp" class="sc-brand-logo" asp-append-version="true" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#scNav" aria-controls="scNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="scNav">
                    <ul class="navbar-nav me-auto mt-2 mt-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Index"><i class="bi bi-house-door me-1"></i>Home</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-page="/Admin/Dashboard"><i class="bi bi-speedometer2 me-1"></i>Admin</a>
                                </li>
                            }
                            @if (User.IsInRole("Manager"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-page="/Manager/Dashboard"><i class="bi bi-person-workspace me-1"></i>Supervisor</a>
                                </li>
                            }
                            @if (User.IsInRole("Participant"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-page="/Participant/ConferenceRegistration"><i class="bi bi-ui-checks me-1"></i>Registration</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-page="/Participant/Dashboard"><i class="bi bi-person-badge me-1"></i>Dashboard</a>
                                </li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <span class="nav-link text-secondary py-lg-2"><i class="bi bi-person-circle me-1"></i>@User.Identity?.Name</span>
                            </li>
                            <li class="nav-item">
                                <form method="post" asp-page="/Logout" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-light mt-2 mt-lg-0">Sign out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Login">Sign in</a></li>
                            <li class="nav-item">
                                <a class="btn btn-sm btn-primary ms-lg-2 mt-2 mt-lg-0" asp-page="/Register">Create account</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="pb-5">
        @RenderBody()
    </main>

    <footer class="sc-footer">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
            <span>StudentConferenceApp — participant registration &amp; documentation</span>
            <span class="text-secondary">@DateTime.UtcNow.Year</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
