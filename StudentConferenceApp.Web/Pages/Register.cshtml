@page
@model RegisterModel

@{
    ViewData["Title"] = "Participant Registration";
}

<div class="container mt-4">
    <h2>Conference Participant Registration</h2>
    
    <form method="post">
        <div class="row">
            <!-- Personal Information -->
            <div class="col-md-6">
                <h4>Personal Information</h4>
                <div class="mb-3">
                    <label class="form-label">Full Name</label>
                    <input asp-for="Input.FullName" class="form-control" />
                    <span asp-validation-for="Input.FullName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Educational Institution</label>
                    <input asp-for="Input.Institution" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Paper Title</label>
                    <input asp-for="Input.PaperTitle" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Phone Number</label>
                    <input asp-for="Input.Phone" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input asp-for="Input.Email" class="form-control" />
                </div>
            </div>

            <!-- Participation Details -->
            <div class="col-md-6">
                <h4>Participation Details</h4>
                <div class="mb-3">
                    <label class="form-label">Section</label>
                    <select asp-for="Input.SectionId" class="form-select">
                        <option value="">Select Section</option>
                        <!-- Populate from database in code-behind -->
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Participation Method</label>
                    <select asp-for="Input.ParticipationMethod" class="form-select">
                        <option value="In-person">In-person</option>
                        <option value="Part-time">Part-time</option>
                        <option value="Remote">Remote</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Manager Information -->
        <h4 class="mt-4">Scientific Supervisor / Manager (if any)</h4>
        <div class="row">
            <div class="col-md-6">
                <input asp-for="Input.ManagerFullName" class="form-control" placeholder="Manager Full Name" />
            </div>
            <div class="col-md-6">
                <input asp-for="Input.ManagerEmployment" class="form-control" placeholder="Place of Employment" />
            </div>
        </div>

        <button type="submit" class="btn btn-success mt-4">Register Now</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}