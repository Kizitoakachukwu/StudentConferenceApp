@page
@model StudentConferenceApp.Web.Pages.Participant.DashboardModel

@{
    ViewData["Title"] = "Participant Dashboard";
}

<div class="container">
    <h2 class="mb-4">Welcome, @Model.Participant?.FullName</h2>

    <div class="row">
        <!-- Status Card -->
        <div class="col-md-4">
            <div class="card text-center h-100">
                <div class="card-header bg-info text-white">
                    Registration Status
                </div>
                <div class="card-body">
                    <h3 class="text-@GetStatusColor(Model.Participant?.Status)">
                        @Model.Participant?.Status
                    </h3>
                    <p class="text-muted">Registration Date: @Model.Participant?.RegistrationDate.ToString("dd MMMM yyyy")</p>
                </div>
            </div>
        </div>

        <!-- Participation Info -->
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-header bg-primary text-white">
                    Participation Details
                </div>
                <div class="card-body">
                    <p><strong>Section:</strong> @Model.Participant?.SectionName</p>
                    <p><strong>Method:</strong> @Model.Participant?.ParticipationMethod</p>
                    <p><strong>Paper Title:</strong> @Model.Participant?.PaperTitle</p>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-header bg-success text-white">
                    Quick Actions
                </div>
                <div class="card-body d-grid gap-2">
                    <a asp-page="/Participant/MyDocuments" class="btn btn-outline-success">View Documents</a>
                    <a asp-page="/Register" class="btn btn-outline-primary">Edit Registration</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Manager Information -->
    @if (Model.Participant?.Manager != null)
    {
        <div class="mt-4">
            <h4>Scientific Supervisor / Manager</h4>
            <div class="card">
                <div class="card-body">
                    <p><strong>Name:</strong> @Model.Participant.Manager.FullName</p>
                    <p><strong>Position:</strong> @Model.Participant.Manager.Position</p>
                    <p><strong>Institution:</strong> @Model.Participant.Manager.PlaceOfEmployment</p>
                    <p><strong>Degree:</strong> @Model.Participant.Manager.AcademicDegree</p>
                </div>
            </div>
        </div>
    }

    <!-- Uploaded Files -->
    <div class="mt-4">
        <h4>Uploaded Files</h4>
        <div class="table-responsive">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>File Type</th>
                        <th>File Name</th>
                        <th>Upload Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var file in Model.UploadedFiles)
                    {
                        <tr>
                            <td>@file.FileType</td>
                            <td>@file.FileName</td>
                            <td>@file.UploadedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@functions {
    private string GetStatusColor(string? status)
    {
        return status?.ToLower() switch
        {
            "approved" => "success",
            "rejected" => "danger",
            _ => "warning"
        };
    }
}